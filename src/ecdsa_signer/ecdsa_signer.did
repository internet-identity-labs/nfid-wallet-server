type KeyPair = record {
    public_key : text;
    private_key_encrypted : text
};

type KeyPairResponse = record {
    key_pair : opt KeyPair;
    princ : text
};

type CertifiedKeyPairResponse = record {
    response: KeyPairResponse;
    certificate: vec nat8;
    witness: vec nat8;
};

type StorageVariant = variant { ETH; BTC; II };

type Conf = record {
    controllers : opt vec principal;
    storage : opt StorageVariant;
    im_canister : opt text;
};

// Response of the Identity Manager `get_root_certified`, requested by the caller itself.
type CertifiedRoot = record {
    root : text;
    certificate : blob;
    witness : blob;
};

type AnonymousDelegationRequest = record {
    certified_root : CertifiedRoot;
    domain : text;
    session_key : blob;
    // Empty means an unrestricted delegation.
    targets : vec principal;
    delegation_ttl_ms : opt nat64;
};

type GlobalDelegationRequest = record {
    certified_root : CertifiedRoot;
    session_key : blob;
    // Empty means an unrestricted delegation.
    targets : vec principal;
    delegation_ttl_ms : opt nat64;
};

type AnonymousPrincipalRequest = record {
    certified_root : CertifiedRoot;
    domain : text;
};

type Delegation = record {
    pubkey : blob;
    expiration : nat64;
    targets : opt vec principal;
};

type SignedDelegation = record {
    delegation : Delegation;
    signature : blob;
};

type DelegationChain = record {
    delegations : vec SignedDelegation;
    public_key : blob;
};

type DelegationResult = variant { Ok : DelegationChain; Err : text };

// Hex-encoded X25519 + ChaCha20-Poly1305 envelope sealed by the lambda (migrate_salts).
type SealedSalts = record {
    ephemeral_public_key : text;
    nonce : text;
    ciphertext : text;
};

type LegacySignerStatus = record {
    im_canister : opt text;
    salts_provisioned : bool;
    salts_fingerprint : opt text;
    provisioning_key_pending : bool;
    global_keys : nat64;
};

service : (opt Conf) -> {
    // Key storage, written by the lambda.
    add_kp : (KeyPair) -> ();
    get_kp : () -> (KeyPairResponse);
    get_public_key : (text) -> (opt text) query;
    get_principal : (opt text) -> (text, opt text) query;

    // Admins (controllers after sync_controllers).
    get_kp_certified : (text) -> (CertifiedKeyPairResponse) query;
    get_all_json : (nat32, nat32) -> (text) query;
    count : () -> (nat64) query;
    reconfig : (Conf) -> ();
    sync_controllers : () -> (vec text);

    // Legacy delegations (anchor < 200_000_000), signed with the stored keys and the lambda salts.
    get_global_delegation : (GlobalDelegationRequest) -> (DelegationResult);
    get_anonymous_delegation : (AnonymousDelegationRequest) -> (DelegationResult);
    get_anonymous_principal : (AnonymousPrincipalRequest) -> (variant { Ok : principal; Err : text });

    // Salt delivery: controllers and the delegation lambda of the Identity Manager (get_config().lambda).
    get_provisioning_key : () -> (variant { Ok : text; Err : text });
    // Returns the fingerprint of the loaded salts.
    provision_salts : (SealedSalts) -> (variant { Ok : text; Err : text });
    // Controllers only.
    legacy_signer_status : () -> (variant { Ok : LegacySignerStatus; Err : text }) query;
};
